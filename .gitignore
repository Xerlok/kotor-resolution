# Copyrighted/redistribution-risk game data and third-party downloads
backups/
downloads/
staging/

# Python
__pycache__/
*.pyc

# PyKotor writes these the moment it is imported; always empty here.
logs/

# Patcher run artefacts: a player's own exe backup and install record, written
# when the patcher is run from the repo. Never part of the release.
patcher/backup/
patcher/installed.json
patcher/installed.json.reverted
patcher/last-run-log.txt
patcher/dist/
patcher/build/

# Release build output: the frozen build and the zip, both regenerable with
# `python tools/build_release.py`.
dist/

# Internal dev notes, not part of the public repo.
docs/
